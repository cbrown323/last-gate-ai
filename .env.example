# Last Gate AI local configuration — copy this file to .env.local.
# REQUIRED for persistence. Keep this path unless you intentionally store the
# SQLite database elsewhere. Relative paths are resolved from the repository root.
DATABASE_URL="file:./data/last-gate.db"

# OPTIONAL. Enables Settings to write credentials to .env.local in production.
# Leave false when the app is reachable by anyone you do not fully trust.
ALLOW_ENV_KEY_UI=false

# OPTIONAL for the dashboard; REQUIRED for GitHub import and sync.
# Classic PAT: repo scope. Fine-grained PAT: Metadata + Contents read access.
GITHUB_TOKEN=

# OPTIONAL. AI summaries use the existing offline behavior when both keys are blank.
# Set only one provider. AI Gateway is recommended.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# OPTIONAL. Deployment API verification in Settings.
VERCEL_TOKEN=

# OPTIONAL. Railway deployment API verification in Settings.
RAILWAY_TOKEN=

# OPTIONAL for local use; REQUIRED before exposing the cron route publicly.
CRON_SECRET=
